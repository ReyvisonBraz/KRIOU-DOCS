{
  "name": "kriou-docs",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma web para criação e gestão segura de documentos profissionais e jurídicos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "E2E_BASE_URL=http://127.0.0.1:5174 node scripts/setup-local-e2e.mjs && E2E_LOCAL=1 E2E_BASE_URL=http://127.0.0.1:5174 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:setup": "playwright test e2e/auth.setup.js --project=setup",
    "test:e2e:public": "playwright test e2e/landing.spec.js e2e/navigation.spec.js",
    "test:e2e:responsive": "playwright test e2e/interface.responsive.spec.js",
    "test:security:local": "node scripts/test-local-security.mjs",
    "test:documents:local": "node scripts/test-local-document-sync.mjs",
    "test:admin-functions:local": "node scripts/test-local-admin-functions.mjs",
    "quality": "npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.103.2",
    "jspdf": "^4.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "postgres": "^3.4.9",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
